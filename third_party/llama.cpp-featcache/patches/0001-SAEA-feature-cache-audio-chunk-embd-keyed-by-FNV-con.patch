From b3dc62149483e0b9108bbba340b5c59f5a6ba9b9 Mon Sep 17 00:00:00 2001
From: SAEA study <saea@local>
Date: Tue, 11 Aug 2026 11:47:08 -0400
Subject: [PATCH 1/4] SAEA feature cache: audio-chunk embd keyed by FNV content
 hash (RAM + LLAMA_MTMD_FEAT_CACHE_DIR); hit decodes from cache and skips the
 encoder; miss encodes and back-fills. Fail-safe fallback to the stock path.

---
 tools/server/server-context.cpp | 93 +++++++++++++++++++++++++++++++++
 1 file changed, 93 insertions(+)

diff --git a/tools/server/server-context.cpp b/tools/server/server-context.cpp
index 39b7eb218..c2f63a761 100644
--- a/tools/server/server-context.cpp
+++ b/tools/server/server-context.cpp
@@ -1,4 +1,10 @@
 #include "server-context.h"
+// SAEA feature-cache patch (2026-08-11): headers
+#include <cctype>
+#include <cstdio>
+#include <cstdlib>
+#include <mutex>
+#include <unordered_map>
 #include "server-chat.h"
 #include "server-common.h"
 #include "server-http.h"
@@ -701,10 +707,72 @@ struct server_slot {
         const auto & chunk = input_tokens.find_chunk(idx);
         int32_t res = 0;
 
+        // ==== SAEA feature cache (2026-08-11): audio features keyed by the
+        // chunk's FNV content hash; RAM layer + LLAMA_MTMD_FEAT_CACHE_DIR
+        // persistence. A hit decodes from the cached embd and skips the
+        // encoder entirely; a miss encodes as before and back-fills. ====
+        static std::mutex feat_mu;
+        static std::unordered_map<std::string, std::vector<float>> feat_ram;
+        static const char * feat_dir = std::getenv("LLAMA_MTMD_FEAT_CACHE_DIR");
+        const int64_t n_embd_model = llama_model_n_embd(llama_get_model(ctx_tgt));
+        auto feat_key = [&](const mtmd_input_chunk * c) -> std::string {
+            const char * cid = mtmd_input_chunk_get_id(c);
+            std::string k = cid ? cid : "";
+            for (auto & ch : k) { if (!isalnum((unsigned char) ch)) ch = '_'; }
+            return k;
+        };
+        auto feat_store = [&](const mtmd_input_chunk * c, const float * embd) {
+            if (!feat_dir || !embd) { return; }
+            const std::string key = feat_key(c);
+            if (key.empty()) { return; }
+            const size_t n = (size_t) mtmd_input_chunk_get_n_tokens(c) * (size_t) n_embd_model;
+            {
+                std::lock_guard<std::mutex> lk(feat_mu);
+                if (feat_ram.count(key)) { return; }
+                feat_ram[key].assign(embd, embd + n);
+            }
+            const std::string path = std::string(feat_dir) + "/" + key + ".feat";
+            FILE * f = std::fopen((path + ".tmp").c_str(), "wb");
+            if (!f) { return; }
+            uint64_t hdr[2] = { (uint64_t) mtmd_input_chunk_get_n_tokens(c), (uint64_t) n_embd_model };
+            bool ok = std::fwrite(hdr, sizeof(hdr), 1, f) == 1 &&
+                      std::fwrite(embd, sizeof(float), n, f) == n;
+            std::fclose(f);
+            if (ok) { std::rename((path + ".tmp").c_str(), path.c_str()); }
+            else    { std::remove((path + ".tmp").c_str()); }
+        };
+        auto feat_load = [&](const mtmd_input_chunk * c) -> const std::vector<float> * {
+            if (!feat_dir) { return nullptr; }
+            const std::string key = feat_key(c);
+            if (key.empty()) { return nullptr; }
+            {
+                std::lock_guard<std::mutex> lk(feat_mu);
+                auto it = feat_ram.find(key);
+                if (it != feat_ram.end()) { return &it->second; }
+            }
+            const std::string path = std::string(feat_dir) + "/" + key + ".feat";
+            FILE * f = std::fopen(path.c_str(), "rb");
+            if (!f) { return nullptr; }
+            uint64_t hdr[2];
+            const size_t n_exp = (size_t) mtmd_input_chunk_get_n_tokens(c) * (size_t) n_embd_model;
+            std::vector<float> buf;
+            bool ok = std::fread(hdr, sizeof(hdr), 1, f) == 1 &&
+                      hdr[0] == (uint64_t) mtmd_input_chunk_get_n_tokens(c) &&
+                      hdr[1] == (uint64_t) n_embd_model;
+            if (ok) { buf.resize(n_exp); ok = std::fread(buf.data(), sizeof(float), n_exp, f) == n_exp; }
+            std::fclose(f);
+            if (!ok) { return nullptr; }
+            std::lock_guard<std::mutex> lk(feat_mu);
+            auto res_pair = feat_ram.emplace(key, std::move(buf));
+            return &res_pair.first->second;
+        };
+        // ==== end feature cache ====
+
         auto try_decode = [&]() -> int32_t {
             if (mbatch) {
                 float * embd = mtmd_batch_get_output_embd(mbatch.get(), chunk.get());
                 if (embd) {
+                    feat_store(chunk.get(), embd);
                     void * cb_data = spec;
                     static auto cb = [](llama_batch batch, void * user_data) {
                         common_speculative * spec = static_cast<common_speculative *>(user_data);
@@ -748,6 +816,31 @@ struct server_slot {
             return res;
         }
 
+        // SAEA feature cache: decode this chunk from a cached embd and skip
+        // the encoder entirely (RAM layer, then LLAMA_MTMD_FEAT_CACHE_DIR).
+        if (const std::vector<float> * cached = feat_load(chunk.get())) {
+            void * cb_data = spec;
+            static auto cb = [](llama_batch batch, void * user_data) {
+                common_speculative * spec = static_cast<common_speculative *>(user_data);
+                if (!common_speculative_process(spec, batch)) {
+                    return 1;
+                }
+                return 0;
+            };
+            llama_pos new_n_past;
+            res = mtmd_helper_decode_image_chunk(
+                mctx, ctx_tgt, chunk.get(),
+                const_cast<float *>(cached->data()),
+                prompt.tokens.pos_next(), id, llama_n_batch(ctx_tgt),
+                &new_n_past, cb, cb_data);
+            if (res == 0) {
+                SLT_INF(*this, "mtmd feat-cache HIT, chunk idx = %zu\n", idx);
+                n_tokens_out = mtmd_input_chunk_get_n_tokens(chunk.get());
+                return 0;
+            }
+            SLT_ERR(*this, "feat-cache decode failed (res = %d); falling back to encode\n", res);
+        }
+
         // otherwise, the batch is either uninitialized or is used up
         // we need to create & encode a new batch
         mbatch.reset(mtmd_batch_init(mctx));
-- 
